# Copy this to .env and fill in your values.
# NEVER commit .env — it's in .gitignore.

# Your Gmail address (the one you're sending FROM)
GMAIL_ADDRESS=you@gmail.com

# App Password — NOT your regular Gmail password.
# Get it: myaccount.google.com → Security → 2-Step Verification → App Passwords
# Create one for "Mail" — copy the 16-character code.
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx

# Where to deliver the brief (your phone email, or same as above)
RECIPIENT_EMAIL=you@gmail.com

# Your GitHub Pages URL — set this once after enabling Pages (Step 3 below).
# Example: https://haydendonehower.github.io/market-brief/
PAGE_URL=https://YOUR_USERNAME.github.io/market-brief/
